{
  "name": "how-did-you-know-that",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "sim": "tsx sim/run.ts",
    "sim:tune": "tsx sim/tune.ts",
    "sim:report": "tsx sim/report.ts",
    "sim:tapes": "tsx sim/tape.ts",
    "sim:determinism": "tsx sim/determinism.ts",
    "playtest:report": "tsx sim/report-logs.ts",
    "test:e2e": "npm run build && node tools/e2e.mjs",
    "game-night": "node tools/game-night.mjs",
    "host-voice": "node tools/host-voice.mjs",
    "tutorial:video": "node tools/tutorial-video.mjs",
    "avatars": "node tools/avatars.mjs"
  },
  "dependencies": {
    "idiomorph": "^0.8.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
